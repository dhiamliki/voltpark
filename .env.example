# Copier ce fichier en .env avant de lancer docker compose : cp .env.example .env
# Ne jamais commiter le fichier .env (il est ignore par git).
# Les valeurs ci-dessous sont des exemples, a remplacer.

# --- session-db ---
SESSION_DB_NAME=session_db
SESSION_DB_USER=session_user
SESSION_DB_PASSWORD=change_me
SESSION_DB_URL=jdbc:postgresql://session-db:5432/session_db

# --- charger-db ---
CHARGER_DB_NAME=charger_db
CHARGER_DB_USER=charger_user
CHARGER_DB_PASSWORD=change_me
CHARGER_DB_URL=jdbc:postgresql://charger-db:5432/charger_db

# --- energy-db ---
ENERGY_DB_NAME=energy_db
ENERGY_DB_USER=energy_user
ENERGY_DB_PASSWORD=change_me
ENERGY_DB_URL=jdbc:postgresql://energy-db:5432/energy_db

# --- Tarification (energy-service) ---
PEAK_START=08:00
PEAK_END=20:00
TARIFF_ZONE=Africa/Tunis

# --- Simulateur de bornes ---
SIMULATOR_ENABLED=true
SIMULATOR_CHARGER_ID=CP-TUN-001
SIMULATOR_INTERVAL_SECONDS=120
SIMULATOR_DURATION_SECONDS=60

# --- Adresses entre services (DNS Docker Compose) ---
CHARGER_GATEWAY_URL=http://charger-gateway-service:8082/ws
ENERGY_GRPC_ADDRESS=static://energy-service:9090
SESSION_SERVICE_URL=http://session-service:8081

# --- API Gateway ---
GATEWAY_CONNECT_TIMEOUT_MS=2000
GATEWAY_RESPONSE_TIMEOUT=5s
# Origines autorisees (CORS), separees par des virgules.
# Doit contenir l'URL du frontend : http://localhost:<FRONTEND_HOST_PORT>
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (injecte au build) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- Ports publies sur la machine hote (a changer en cas de conflit) ---
GATEWAY_HOST_PORT=8080
SESSION_HOST_PORT=8081
CHARGER_GATEWAY_HOST_PORT=8082
ENERGY_HOST_PORT=8083
ENERGY_GRPC_HOST_PORT=9090
FRONTEND_HOST_PORT=3000
